<?xml version="1.0" encoding="utf-8"?>
<!-- A esfera que flutua sobre o vidro: um cajuí de luz, do âmbar ao
     terracota, com o reflexo de uma janela no alto. É o toque surreal: um
     fruto suspenso, maior que a vida, fora do painel. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- O tamanho da esfera é o da própria camada de baixo: sem ele, a
         camada do reflexo dava a proporção ao desenho, e a esfera saía
         achatada no aparelho. -->
    <item
        android:width="40dp"
        android:height="40dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#FFE4572E"
                android:centerX="0.35"
                android:centerY="0.3"
                android:endColor="#FF8F2D10"
                android:gradientRadius="70%"
                android:startColor="#FFF0C26A"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:width="18dp"
        android:height="12dp"
        android:gravity="top|start"
        android:left="12dp"
        android:top="9dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00FFFFFF"
                android:gradientRadius="50%"
                android:startColor="#D9FFFFFF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
