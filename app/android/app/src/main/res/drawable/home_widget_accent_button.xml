<?xml version="1.0" encoding="utf-8"?>
<!-- O botão de lançar: a pílula cheia na cor de ação, como o "Lançar" do
     app, com a mesma borda de luz dos botões de vidro. É o único cheio do
     widget porque é a ação principal; câmera e galeria ficam de vidro. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="22dp" />
    <solid android:color="@color/cajui_accent" />
    <stroke
        android:width="1dp"
        android:color="#73FFFFFF" />
</shape>
