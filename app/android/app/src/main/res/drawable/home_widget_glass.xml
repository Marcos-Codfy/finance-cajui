<?xml version="1.0" encoding="utf-8"?>
<!-- O painel de vidro: um véu branco translúcido, a borda de luz e o
     reflexo no alto. O RemoteViews não desfoca o que está atrás; o vidro
     parece fosco porque a aurora por baixo já é toda difusa. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#14FFFFFF"
                android:startColor="#38FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#5CFFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- O reflexo: a luz que bate no alto do vidro e some no meio. -->
    <item
        android:height="44dp"
        android:gravity="top|fill_horizontal"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#29FFFFFF" />
            <corners
                android:topLeftRadius="21dp"
                android:topRightRadius="21dp" />
        </shape>
    </item>
</layer-list>
