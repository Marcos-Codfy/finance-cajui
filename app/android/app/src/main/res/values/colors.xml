<?xml version="1.0" encoding="utf-8"?>
<!-- As cores do que o Cajui desenha fora do Flutter: o widget da tela
     inicial e a cor das notificações (ADR-025). São as mesmas do design
     system (`cajui_palette.dart`), tema claro; o escuro está em
     `values-night`. Quem muda a paleta lá muda aqui junto. -->
<resources>
    <!-- O texto sobre o vidro do widget: o widget é sempre a aurora à noite,
         nos dois temas, então o texto é sempre claro. paper -->
    <color name="cajui_glass_text">#FFFFFFFF</color>
    <!-- moon, a 80% -->
    <color name="cajui_glass_text_muted">#CCF4ECE0</color>
    <!-- cajuiStrong -->
    <color name="cajui_accent">#FFB93D17</color>
    <!-- paper, sobre o cajuiStrong -->
    <color name="cajui_on_accent">#FFFFFFFF</color>
</resources>
